{
  "manifest_version": 3,
  "name": "Tab Wallpaper",
  "version": "2.0.0",
  "description": "Display a random image on every new tab.",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/tab.png",
    "48": "icons/tab.png",
    "128": "icons/tab.png"
  }
}
